# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
*.egg-info/
.dist-info/
*.egg

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# C extensions
*.so

# Python Wheels
*.whl

# Jupyter Notebook checkpoints
.ipynb_checkpoints

# --- Finnegans Fake: local-only artefacts ---
# The corpus itself stays off the public repo. Joyce died in 1941, so the text is
# public domain in Ireland/UK/EU but NOT in the US until 2035. Fetch it locally.
data/*.txt
data/*.jsonl
# Raw Project Gutenberg downloads for the plain-English expert. Public domain, so
# the licence is not the reason — they are a 6MB reproducible download and
# wake/prepare_english.py --fetch rebuilds them byte-for-byte.
data/gutenberg/
# trained weights + logs
wake/*/
wake/*.log

# Reproducible intermediate: recut_windows.py regenerates it from the live board,
# and every window it selected is carried verbatim in wake/teacher-folds.json.
wake/recut-windows.json
wake/*.out
# PREFIX subsets of the teacher corpus written by run-seed-spread.sh — derived, one line of code
wake/teacher-folds-*.json
